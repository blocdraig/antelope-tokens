{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Antelope Token List",
  "description": "Schema for chain token lists.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "symbol",
      "contract",
      "name"
    ],
    "properties": {
      "symbol": {
        "type": "string",
        "minLength": 1,
        "maxLength": 7,
        "pattern": "^[A-Z0-9]+$"
      },
      "contract": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12,
        "pattern": "^[a-z1-5.]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "website": {
        "type": "string",
        "pattern": "^https?://.+[^/]$"
      },
      "social": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "coinmarketcap": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "coingecko": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "twitter": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "discord": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(discord\\.gg/[A-Za-z0-9-]+|discord\\.com/invite/[A-Za-z0-9-]+)$"
          },
          "telegram": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "instagram": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._]+$"
          },
          "medium": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          },
          "facebook": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.]+$"
          },
          "youtube": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "wechat": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "reddit": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    }
  }
}